[Unit]
Description=aginxMemory - external kv+tree memory service (PostgreSQL)
After=network.target postgresql.service
Before=opencarrier.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/.opencarrier
# DATABASE_URL: PG connection. AGINX_MEMORY_WORKER_COUNT: start at 0 (queue-only),
# ramp to 1 then 4 after observing the seal/digest/topic_route pipeline.
# AGINX_MEMORY_SCHEDULER: leave off until the digest path is validated manually.
Environment=DATABASE_URL=postgres:///aginx_memory
Environment=AGINX_MEMORY_LISTEN=127.0.0.1:4300
Environment=CONTENT_ROOT=/home/ubuntu/.opencarrier/memory_tree/content
Environment=AGINX_MEMORY_WORKER_COUNT=0
Environment=AGINX_MEMORY_SCHEDULER=off
Environment=RUST_LOG=aginx_memory=info
ExecStart=/home/ubuntu/.opencarrier/aginx-memory
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
